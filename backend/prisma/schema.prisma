generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1: authentication + roles.
// Roles are a lookup table (not a Postgres enum) specifically so new roles
// (Service Advisor, Technician, Accountant, ...) can be added later with a
// plain insert instead of a schema migration.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

// permissions is only meaningful for non-ADMIN users — ADMIN is always a
// superuser regardless of this list (see middleware/requirePermission.ts).
// It's a plain string array (not a join table) for the same reason Role is
// a lookup table rather than an enum: the exact set of grantable modules
// can grow without a migration, and per-user grants don't need referential
// integrity beyond "is this string one we currently recognize" (checked at
// the API layer, not the DB layer).
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  roleId       Int       @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  permissions  String[]  @default([])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  employeeAdvances EmployeeAdvance[]
  invoicePayments  InvoicePayment[]
  jobCards        JobCard[]
  jobCardParts    JobCardPart[]
  invoices        Invoice[]
  attendanceEdits Attendance[]

  @@map("users")
}

// Opaque refresh tokens are stored hashed, never in plaintext, so a leaked
// database dump alone can't be used to impersonate a session.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// Phase 2: masters. Records are never hard-deleted (isActive toggles instead)
// since Job Cards/Purchases will reference these in later phases and history
// must never be lost (master spec section 23).
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String   @unique
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]

  @@map("customers")
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  registrationNumber String    @unique @map("registration_number")
  make               String
  model              String
  variant            String?
  year               Int?
  fuelType           String?   @map("fuel_type")
  transmission       String?
  currentKm          Int?      @map("current_km")
  chassisNumber      String?   @map("chassis_number")
  engineNumber       String?   @map("engine_number")
  // Next general service: set when the vehicle is added, then moved on
  // automatically by each General Service job card (see
  // lib/serviceSchedule.ts) — whichever of the date or the km comes first.
  nextServiceDue     DateTime? @map("next_service_due")
  nextServiceKm      Int?      @map("next_service_km")
  // Photo of the registration certificate — required when a vehicle is
  // added (vehicles added before 2026-09-30 may not have one).
  rcPhotoUrl         String?   @map("rc_photo_url")
  customerId         Int       @map("customer_id")
  customer           Customer  @relation(fields: [customerId], references: [id])
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  jobCards JobCard[]

  @@map("vehicles")
}

// itemCode is assigned server-side right after insert (ITM-000123, derived
// from the row's own id) — never typed by a user, so it can never collide.
// currentStock is a denormalized count of this item's ItemUnit rows with
// status IN_STOCK, kept in sync transactionally alongside every purchase
// and every parts-issue/reversal — see purchases.service.ts and
// jobCardParts.service.ts.
model Item {
  id           Int      @id @default(autoincrement())
  itemCode     String   @unique @map("item_code")
  name         String
  category     String
  subCategory  String?  @map("sub_category")
  partNumber   String?  @map("part_number")
  brand        String?
  vehicleMake  String?  @map("vehicle_make")
  vehicleModel String?  @map("vehicle_model")
  variant      String?
  uom          String
  purchaseCost Decimal  @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  minStock     Int      @default(0) @map("min_stock")
  currentStock Int      @default(0) @map("current_stock")
  photoUrl     String?  @map("photo_url")
  remarks      String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchases    Purchase[]
  units        ItemUnit[]
  jobCardParts JobCardPart[]

  @@map("items")
}

// Phase 3/Rev2: purchase + inventory.
model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?  @map("contact_person")
  mobile        String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  payments  SupplierPayment[]

  @@map("suppliers")
}

// Payments are made to a supplier's running account, not against any one
// purchase — the workshop pays a supplier "₹20,000 towards the balance", not
// per bill. One row per payment (so partial-payment history is kept, with
// when/how much/how), and the balance due is always computed (sum of the
// supplier's purchases minus sum of these), never stored.
model SupplierPayment {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  paymentMode String?  @map("payment_mode")
  reference   String?
  paidBy      String?  @map("paid_by")
  proofUrl    String?  @map("proof_url") // photo/screenshot of the transaction
  notes       String?
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("supplier_payments")
}

// A Purchase is one buying event. For inventory types (SPARE_PART/PAINT/
// TOOL) it references an Item and generates one ItemUnit per unit of
// quantity — each physical part gets its own permanent, never-reused
// serial number (the ItemUnit's own id), per the workshop's actual
// practice of writing a serial on a sticker for every part received, even
// when several identical parts arrive in the same purchase. For expense
// types (TRAVEL/PETROL/FOOD/OTHERS) itemId/units are unused — it's just a
// cost record with no stock implications.
//
// One purchase entry in the UI can contain several items from the same
// supplier; each item becomes its own Purchase row (sharing supplier, date,
// bill and remarks), created together in one transaction. Payment is not
// tracked per purchase — see SupplierPayment.
// sellingPrice is shown as "MRP" in the UI.
// supplierId is required for inventory types (enforced in the service) and
// normally empty for expenses — petrol or food isn't bought on a supplier's
// account. Expenses recorded before 2026-09-30 may still have one.
model Purchase {
  id               Int       @id @default(autoincrement())
  purchaseDate     DateTime  @default(now()) @map("purchase_date")
  supplierId       Int?      @map("supplier_id")
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  itemType         String    @map("item_type") // SPARE_PART | PAINT | TOOL | TRAVEL | PETROL | FOOD | OTHERS
  itemId           Int?      @map("item_id") // set only for inventory item types
  item             Item?     @relation(fields: [itemId], references: [id])
  description      String? // for expense-type purchases (no item)
  quantity         Int       @default(1)
  purchaseCost     Decimal   @db.Decimal(12, 2) @map("purchase_cost") // per unit for inventory; total for expenses
  sellingPrice     Decimal?  @db.Decimal(12, 2) @map("selling_price")
  billUrl          String?   @map("bill_url")
  remarks          String?
  createdById      Int       @map("created_by_id")
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")

  units ItemUnit[]

  @@map("purchases")
}

// One row per physical unit. Its own id IS the unit's permanent serial
// number — assigned the moment it's created, never reused, never
// hand-typed. Parts Issue on a job card consumes one specific ItemUnit
// (entered/scanned by serial), not "an item, minus a quantity" — this is
// the traceability mechanism now: a unit's purchase and jobCardPart
// relations already say exactly where it came from and where it went,
// with no separate ledger needed.
model ItemUnit {
  id         Int      @id @default(autoincrement())
  itemId     Int      @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id])
  purchaseId Int      @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  status     String   @default("IN_STOCK") // IN_STOCK | ISSUED
  createdAt  DateTime @default(now()) @map("created_at")

  jobCardPart JobCardPart?

  @@map("item_units")
}

// Phase 4/Rev2: Job Card is the central sales-side workflow record.
// jobCardNumber follows the same pattern as Item Code — derived from the
// row's own id right after insert (JC-000123), never hand-typed.
//
// Status is a plain string (not a Postgres enum), same reasoning as Role.
// Parts/labour edits are blocked from INVOICED onward (see
// jobCardParts/jobCardLabour services and lib/jobCardStatus.ts) so a
// financial record, once invoiced, can't silently drift from what was
// actually billed.
model JobCard {
  id            Int      @id @default(autoincrement())
  jobCardNumber String   @unique @map("job_card_number")
  vehicleId     Int      @map("vehicle_id")
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  jobType       String?  @map("job_type") // GENERAL_SERVICE | ACCIDENTAL_CLAIM | AC | DENT_PAINT | MECHANICAL
  kmAtService   Int?     @map("km_at_service")
  complaint     String?
  requiredWork  String?  @map("required_work")
  expectedDelivery DateTime? @map("expected_delivery")
  notes         String?
  status        String   @default("OPEN") // OPEN | INVOICED | CANCELLED — see lib/jobCardStatus.ts

  // Initial inspection
  inspectionFindings String? @map("inspection_findings")

  // Estimate / customer approval — optional step
  estimateAmount     Decimal?  @db.Decimal(12, 2) @map("estimate_amount")
  estimateApproved   Boolean?  @map("estimate_approved") // null = not decided yet
  estimateApprovedAt DateTime? @map("estimate_approved_at")

  // Work assignment
  assignedEmployeeId Int?      @map("assigned_employee_id")
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])

  // Final inspection sign-off
  finalInspectionStatus String?   @map("final_inspection_status") // DONE | NOT_DONE
  finalInspectionBy     String?   @map("final_inspection_by")
  finalInspectionAt     DateTime? @map("final_inspection_at")

  deliveredAt DateTime? @map("delivered_at")

  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  media   JobCardMedia[]
  parts   JobCardPart[]
  labour  JobCardLabour[]
  invoice Invoice?

  @@map("job_cards")
}

// Vehicle inspection photos/video, always linked to both the Job Card and
// (through it) the vehicle. phase (BEFORE/AFTER) distinguishes the two
// mandatory photo rounds the workshop actually does.
model JobCardMedia {
  id        Int      @id @default(autoincrement())
  jobCardId Int      @map("job_card_id")
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  mediaType String   @map("media_type") // PHOTO | VIDEO
  angle     String? // FRONT/REAR/LEFT/RIGHT/ROOF/INTERIOR/DASHBOARD/GLOVE_BOX/BOOT/WALKAROUND/OTHER
  phase     String   @default("BEFORE") @map("phase") // BEFORE | AFTER
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_card_media")
}

// One row per issued physical unit (one row = one part, since each unit
// already has its own serial — there is no separate "quantity" anymore).
// amount is captured at the moment of issue (from Item.sellingPrice at
// that time) and never recomputed later, so a later item price change
// can't silently change what an already-issued job card is worth.
model JobCardPart {
  id          Int      @id @default(autoincrement())
  jobCardId   Int      @map("job_card_id")
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  itemUnitId  Int      @unique @map("item_unit_id")
  itemUnit    ItemUnit @relation(fields: [itemUnitId], references: [id])
  itemId      Int      @map("item_id")
  item        Item     @relation(fields: [itemId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("job_card_parts")
}

model JobCardLabour {
  id          Int      @id @default(autoincrement())
  jobCardId   Int      @map("job_card_id")
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  description String
  technician  String?
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("job_card_labour")
}

// Phase 5/Rev2: Invoice. Deliberately has no line-item tables of its own —
// parts and labour are read straight from the job card's (already
// immutable, already locked-at-invoice-time) records, so an invoice can
// never show different numbers than the job card it came from.
// invoiceNumber follows the same derive-from-own-id pattern as Item/Job
// Card. taxRate/taxAmount exist now, unused, so GST can be added later
// without a migration touching this table's shape.
// Payments are one InvoicePayment row each (so the history is kept);
// paymentAmount is their running total, kept in step in the same
// transaction as every payment. Pending/Partial/Paid is computed from
// paymentAmount vs totalAmount, never stored.
model Invoice {
  id                Int       @id @default(autoincrement())
  invoiceNumber     String    @unique @map("invoice_number")
  jobCardId         Int       @unique @map("job_card_id")
  jobCard           JobCard   @relation(fields: [jobCardId], references: [id])
  invoiceDate       DateTime  @default(now()) @map("invoice_date")
  partsTotal        Decimal   @db.Decimal(12, 2) @map("parts_total")
  labourTotal       Decimal   @db.Decimal(12, 2) @map("labour_total")
  discount          Decimal   @default(0) @db.Decimal(12, 2)
  taxRate           Decimal?  @db.Decimal(5, 2) @map("tax_rate")
  taxAmount         Decimal?  @db.Decimal(12, 2) @map("tax_amount")
  totalAmount       Decimal   @db.Decimal(12, 2) @map("total_amount")
  paymentAmount     Decimal   @default(0) @db.Decimal(12, 2) @map("payment_amount")
  createdById       Int       @map("created_by_id")
  createdBy         User      @relation(fields: [createdById], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")

  payments InvoicePayment[]

  @@map("invoices")
}

// One customer payment towards an invoice. Recorded from the invoice page,
// or from the Customers/Vehicles pages against a chosen unpaid invoice.
model InvoicePayment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  paymentMode String?  @map("payment_mode")
  reference   String?
  receivedBy  String?  @map("received_by")
  notes       String?
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_payments")
}

// Phase 6/Rev2: Attendance → Salary. A self-contained HR module — nothing
// else in the schema depends on it except JobCard's optional Work
// Assignment link.
// email/mobile/passwordHash added for the employee self-service attendance
// portal (separate login from the admin User table — see
// modules/employeePortal). passwordHash stays null until an admin sets a
// portal password for that employee; email is the portal login id.
model Employee {
  id                    Int      @id @default(autoincrement())
  name                  String
  role                  String?
  email                 String?  @unique
  mobile                String?
  passwordHash          String?  @map("password_hash")
  joiningDate           DateTime @map("joining_date")
  monthlySalary         Decimal  @db.Decimal(12, 2) @map("monthly_salary")
  monthlyLeaveAllowance Int      @default(0) @map("monthly_leave_allowance")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  attendance     Attendance[]
  salaryPayments SalaryPayment[]
  advances       EmployeeAdvance[]
  jobCards       JobCard[]

  @@map("employees")
}

// Money paid to an employee ahead of their salary, entered from the
// attendance sheet. It comes out of the salary for salaryMonth/salaryYear:
// normally the month it was given, or the next month when that month's
// salary was already being paid (see advances.service.ts). One row per
// advance, so the history of what was given when is kept.
model EmployeeAdvance {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  salaryMonth Int      @map("salary_month")
  salaryYear  Int      @map("salary_year")
  notes       String?
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([employeeId, salaryYear, salaryMonth])
  @@map("employee_advances")
}

// markedBy distinguishes a self-service portal punch (SELF — punchedAt/
// latitude/longitude always set, selfieUrl set if the employee chose to
// take one) from the admin's manual daily marking (ADMIN — the original
// Phase 6 flow, no location data). Both write the same row.
model Attendance {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  date          DateTime  @db.Date
  status        String // PRESENT | ABSENT | LEAVE
  markedBy      String    @default("ADMIN") @map("marked_by") // ADMIN | SELF
  punchedAt     DateTime? @map("punched_at")
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  selfieUrl     String?   @map("selfie_url")
  correctedById Int?      @map("corrected_by_id")
  correctedBy   User?     @relation(fields: [correctedById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@map("attendance")
}

// One row per employee per calendar month. grossSalary/netSalary are
// computed at calculation time from that month's Attendance rows (see
// employees.service.ts for the exact formula) and stored so a later
// attendance correction doesn't silently change an already-paid salary —
// recalculating is an explicit action, not automatic.
model SalaryPayment {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  periodMonth   Int       @map("period_month")
  periodYear    Int       @map("period_year")
  presentDays   Int       @map("present_days")
  absentDays    Int       @map("absent_days")
  leaveDays     Int       @map("leave_days")
  grossSalary   Decimal   @db.Decimal(12, 2) @map("gross_salary")
  // Total of the advances charged to this month, at calculation time.
  advanceDeduction Decimal @default(0) @db.Decimal(12, 2) @map("advance_deduction")
  netSalary     Decimal   @db.Decimal(12, 2) @map("net_salary")
  paymentAmount Decimal   @default(0) @db.Decimal(12, 2) @map("payment_amount")
  paymentDate   DateTime? @map("payment_date")
  paymentMode   String?   @map("payment_mode")
  paymentBy     String?   @map("payment_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([employeeId, periodMonth, periodYear])
  @@map("salary_payments")
}

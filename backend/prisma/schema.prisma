generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1: authentication + roles.
// Roles are a lookup table (not a Postgres enum) specifically so new roles
// (Service Advisor, Technician, Accountant, ...) can be added later with a
// plain insert instead of a schema migration.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  roleId       Int       @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  purchases          Purchase[]
  stockLedgerEntries StockLedger[]
  jobCards           JobCard[]
  jobCardParts       JobCardPart[]
  invoices           Invoice[]

  @@map("users")
}

// Opaque refresh tokens are stored hashed, never in plaintext, so a leaked
// database dump alone can't be used to impersonate a session.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// Phase 2: masters. Records are never hard-deleted (isActive toggles instead)
// since Job Cards/Purchases will reference these in later phases and history
// must never be lost (master spec section 23).
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String   @unique
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]

  @@map("customers")
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  registrationNumber String    @unique @map("registration_number")
  make               String
  model              String
  variant            String?
  year               Int?
  fuelType           String?   @map("fuel_type")
  transmission       String?
  currentKm          Int?      @map("current_km")
  chassisNumber      String?   @map("chassis_number")
  engineNumber       String?   @map("engine_number")
  nextServiceDue     DateTime? @map("next_service_due")
  customerId         Int       @map("customer_id")
  customer           Customer  @relation(fields: [customerId], references: [id])
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  jobCards JobCard[]

  @@map("vehicles")
}

// itemCode is assigned server-side right after insert (ITM-000123, derived
// from the row's own id) — never typed by a user, so it can never collide.
// currentStock/minStock are populated for real starting in Phase 3 (Purchase);
// they exist here already since they're part of the Item record itself.
model Item {
  id           Int      @id @default(autoincrement())
  itemCode     String   @unique @map("item_code")
  name         String
  category     String
  subCategory  String?  @map("sub_category")
  partNumber   String?  @map("part_number")
  brand        String?
  vehicleMake  String?  @map("vehicle_make")
  vehicleModel String?  @map("vehicle_model")
  variant      String?
  uom          String
  purchaseCost Decimal  @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  minStock     Int      @default(0) @map("min_stock")
  currentStock Int      @default(0) @map("current_stock")
  photoUrl     String?  @map("photo_url")
  remarks      String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchases          Purchase[]
  stockLedgerEntries StockLedger[]
  jobCardParts       JobCardPart[]

  @@map("items")
}

// Phase 3: purchase + inventory.
model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?  @map("contact_person")
  mobile        String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases Purchase[]

  @@map("suppliers")
}

// The Purchase Serial Number required by the spec is simply this row's own
// id: a Postgres identity column is already unique, sequential, and
// impossible for a user to hand-enter — no separate counter needed, and it
// stays one serial number per transaction line regardless of quantity.
model Purchase {
  id           Int      @id @default(autoincrement())
  purchaseDate DateTime @default(now()) @map("purchase_date")
  supplierId   Int      @map("supplier_id")
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  itemId       Int      @map("item_id")
  item         Item     @relation(fields: [itemId], references: [id])
  quantity     Int
  purchaseCost Decimal  @db.Decimal(12, 2) @map("purchase_cost")
  sellingPrice Decimal? @db.Decimal(12, 2) @map("selling_price")
  remarks      String?
  createdById  Int      @map("created_by_id")
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  stockLedgerEntries StockLedger[]

  @@map("purchases")
}

// Append-only movement log — the "item-level ledger" traceability decided in
// Phase 0: every stock change (purchase IN, parts-issue OUT) is recorded
// here with who/when/how much, without tracking exact batches.
model StockLedger {
  id             Int          @id @default(autoincrement())
  itemId         Int          @map("item_id")
  item           Item         @relation(fields: [itemId], references: [id])
  direction      String // "IN" | "OUT"
  quantity       Int
  balanceAfter   Int          @map("balance_after")
  referenceType  String       @map("reference_type") // "PURCHASE" | "JOB_CARD" | "JOB_CARD_REVERSAL"
  purchaseId     Int?         @map("purchase_id")
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id])
  jobCardPartId  Int?         @map("job_card_part_id")
  jobCardPart    JobCardPart? @relation(fields: [jobCardPartId], references: [id], onDelete: SetNull)
  note           String?
  createdById    Int          @map("created_by_id")
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("stock_ledger")
}

// Phase 4: Job Card is the central sales-side workflow record. jobCardNumber
// follows the same pattern as Item Code — derived from the row's own id
// right after insert (JC-000123), never hand-typed.
//
// Status is a plain string (not a Postgres enum), same reasoning as Role:
// it's a fixed list today but shouldn't require a migration to extend.
// Parts/labour edits are blocked once status is INVOICED/CLOSED/CANCELLED
// (see jobCardParts/jobCardLabour services) so a financial record, once
// invoiced, can't silently drift from what was actually billed.
model JobCard {
  id            Int      @id @default(autoincrement())
  jobCardNumber String   @unique @map("job_card_number")
  vehicleId     Int      @map("vehicle_id")
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  kmAtService   Int?     @map("km_at_service")
  complaint     String?
  requiredWork  String?  @map("required_work")
  notes         String?
  status        String   @default("DRAFT")
  createdById   Int      @map("created_by_id")
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  media   JobCardMedia[]
  parts   JobCardPart[]
  labour  JobCardLabour[]
  invoice Invoice?

  @@map("job_cards")
}

// Vehicle inspection photos/video, always linked to both the Job Card and
// (through it) the vehicle, per the master spec's inspection requirement.
model JobCardMedia {
  id        Int      @id @default(autoincrement())
  jobCardId Int      @map("job_card_id")
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  mediaType String   @map("media_type") // "PHOTO" | "VIDEO"
  angle     String? // FRONT/REAR/LEFT/RIGHT/INTERIOR/DASHBOARD/ENGINE_BAY/DAMAGE/WALKAROUND/OTHER
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_card_media")
}

// unitPrice/amount are captured at the moment of issue (from Item.sellingPrice
// at that time) and never recomputed later, so a later item price change
// can't silently change what an already-issued job card is worth.
model JobCardPart {
  id          Int      @id @default(autoincrement())
  jobCardId   Int      @map("job_card_id")
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  itemId      Int      @map("item_id")
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  amount      Decimal  @db.Decimal(12, 2)
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  stockLedgerEntries StockLedger[]

  @@map("job_card_parts")
}

model JobCardLabour {
  id          Int      @id @default(autoincrement())
  jobCardId   Int      @map("job_card_id")
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  description String
  technician  String?
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("job_card_labour")
}

// Phase 5: Invoice. Deliberately has no line-item tables of its own — parts
// and labour are read straight from the job card's (already immutable,
// already locked-at-invoice-time) JobCardPart/JobCardLabour rows, so an
// invoice can never show different numbers than the job card it came from.
// invoiceNumber follows the same derive-from-own-id pattern as Item/Job Card.
// taxRate/taxAmount exist now, unused, so GST can be added later without a
// migration touching this table's shape (master spec section 17).
model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique @map("invoice_number")
  jobCardId     Int      @unique @map("job_card_id")
  jobCard       JobCard  @relation(fields: [jobCardId], references: [id])
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  partsTotal    Decimal  @db.Decimal(12, 2) @map("parts_total")
  labourTotal   Decimal  @db.Decimal(12, 2) @map("labour_total")
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  taxRate       Decimal? @db.Decimal(5, 2) @map("tax_rate")
  taxAmount     Decimal? @db.Decimal(12, 2) @map("tax_amount")
  totalAmount   Decimal  @db.Decimal(12, 2) @map("total_amount")
  createdById   Int      @map("created_by_id")
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("invoices")
}

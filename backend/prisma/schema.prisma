generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1: authentication + roles.
// Roles are a lookup table (not a Postgres enum) specifically so new roles
// (Service Advisor, Technician, Accountant, ...) can be added later with a
// plain insert instead of a schema migration.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

// permissions is only meaningful for non-ADMIN users — ADMIN is always a
// superuser regardless of this list (see middleware/requirePermission.ts).
// It's a plain string array (not a join table) for the same reason Role is
// a lookup table rather than an enum: the exact set of grantable modules
// can grow without a migration, and per-user grants don't need referential
// integrity beyond "is this string one we currently recognize" (checked at
// the API layer, not the DB layer).
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  roleId       Int       @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  permissions  String[]  @default([])
  // Set when a user who has created records is deleted: the row stays so
  // those records still show who made them, but the user is hidden, can't
  // log in, and their email is freed (see users.service.ts#deleteUser).
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  employeeAdvances EmployeeAdvance[]
  invoicePayments  InvoicePayment[]
  paymentAudits    PaymentAudit[]
  estimates        Estimate[]
  jobCards         JobCard[]
  jobCardParts     JobCardPart[]
  invoices         Invoice[]
  attendanceEdits  Attendance[]
  odometerReadings OdometerReading[]

  @@map("users")
}

// Opaque refresh tokens are stored hashed, never in plaintext, so a leaked
// database dump alone can't be used to impersonate a session.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// Phase 2: masters. Records are never hard-deleted (isActive toggles instead)
// since Job Cards/Purchases will reference these in later phases and history
// must never be lost (master spec section 23).
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String   @unique
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]

  @@map("customers")
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  registrationNumber String    @unique @map("registration_number")
  make               String
  model              String
  variant            String?
  year               Int?
  fuelType           String?   @map("fuel_type")
  transmission       String?
  currentKm          Int?      @map("current_km")
  chassisNumber      String?   @map("chassis_number")
  engineNumber       String?   @map("engine_number")
  // Next general service: set when the vehicle is added, then moved on
  // automatically by each General Service job card (see
  // lib/serviceSchedule.ts) — whichever of the date or the km comes first.
  nextServiceDue     DateTime? @map("next_service_due")
  nextServiceKm      Int?      @map("next_service_km")
  // Photo of the registration certificate — required when a vehicle is
  // added (vehicles added before 2026-09-30 may not have one).
  rcPhotoUrl         String?   @map("rc_photo_url")
  customerId         Int       @map("customer_id")
  customer           Customer  @relation(fields: [customerId], references: [id])
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  jobCards         JobCard[]
  odometerReadings OdometerReading[]

  @@map("vehicles")
}

// itemCode is assigned server-side right after insert (0001, 0002, ...,
// derived from the row's own id) — never typed by a user, so it can never
// collide. currentStock is the available quantity: every purchase adds its
// quantity and every job card part takes its quantity out, transactionally
// — see purchases.service.ts and jobCardParts.service.ts.
model Item {
  id            Int      @id @default(autoincrement())
  itemCode      String   @unique @map("item_code")
  name          String
  category      String
  subCategory   String?  @map("sub_category")
  partNumber    String?  @map("part_number")
  brand         String?
  vehicleMake   String?  @map("vehicle_make")
  vehicleModel  String?  @map("vehicle_model")
  variant       String?
  uom           String
  purchaseCost  Decimal  @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  minStock      Int      @default(0) @map("min_stock")
  // Float so part of a unit can be used (0.5 L of oil). Every change is
  // rounded to 3 decimals in SQL (jobCardParts.service.ts) so it stays exact.
  currentStock  Float    @default(0) @map("current_stock")
  specification String?
  photoUrl      String?  @map("photo_url")
  remarks       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases     Purchase[]
  jobCardParts  JobCardPart[]
  estimateLines EstimateLine[]

  @@map("items")
}

// Phase 3/Rev2: purchase + inventory.
model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?  @map("contact_person")
  mobile        String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  payments  SupplierPayment[]

  @@map("suppliers")
}

// Payments are made to a supplier's running account, not against any one
// purchase — the workshop pays a supplier "₹20,000 towards the balance", not
// per bill. One row per payment (so partial-payment history is kept, with
// when/how much/how), and the balance due is always computed (sum of the
// supplier's purchases minus sum of these), never stored.
model SupplierPayment {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  paymentMode String?  @map("payment_mode")
  reference   String?
  paidBy      String?  @map("paid_by")
  proofUrl    String?  @map("proof_url") // photo/screenshot of the transaction
  notes       String?
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("supplier_payments")
}

// An odometer reading entered from the Service Schedule (typically the KM a
// customer sends on WhatsApp), between visits. Job card visits are readings
// too (JobCard.kmAtService); together they give the vehicle's average
// running, which estimates when the next service falls due
// (lib/serviceSchedule.ts).
model OdometerReading {
  id          Int      @id @default(autoincrement())
  vehicleId   Int      @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  km          Int
  readingDate DateTime @default(now()) @map("reading_date")
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([vehicleId, readingDate])
  @@map("odometer_readings")
}

// A Purchase is one buying event. For inventory types (SPARE_PART/PAINT/
// TOOL) it references an Item and adds its quantity to the item's stock.
// Each piece still gets a sticker: stickerFrom..stickerTo is this
// purchase's range of the item's sticker numbers, printed as
// <item number>.<n> (10 of item 0001 → 1.1 – 1.10; the next purchase of it
// continues at 1.11). For expense types (TRAVEL/PETROL/FOOD/OTHERS) itemId
// and the stickers are unused — it's just a cost record with no stock
// implications.
//
// One purchase entry in the UI can contain several items from the same
// supplier; each item becomes its own Purchase row (sharing supplier, date,
// bill and remarks), created together in one transaction. Payment is not
// tracked per purchase — see SupplierPayment.
// sellingPrice is shown as "MRP" in the UI.
// supplierId is required for inventory types (enforced in the service) and
// normally empty for expenses — petrol or food isn't bought on a supplier's
// account. Expenses recorded before 2026-09-30 may still have one.
model Purchase {
  id           Int       @id @default(autoincrement())
  purchaseDate DateTime  @default(now()) @map("purchase_date")
  supplierId   Int?      @map("supplier_id")
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  itemType     String    @map("item_type") // SPARE_PART | PAINT | TOOL | TRAVEL | PETROL | FOOD | OTHERS
  itemId       Int?      @map("item_id") // set only for inventory item types
  item         Item?     @relation(fields: [itemId], references: [id])
  description  String? // for expense-type purchases (no item)
  // Can be part of a unit (2.5 L). Stickers cover each piece, a part piece
  // included (2.5 → 3 stickers).
  quantity     Float     @default(1)
  purchaseCost Decimal   @map("purchase_cost") @db.Decimal(12, 2) // per unit for inventory; total for expenses
  sellingPrice Decimal?  @map("selling_price") @db.Decimal(12, 2)
  billUrl      String?   @map("bill_url")
  // Sticker labels for the pieces in this purchase: "<item no>.<n>" for n
  // from stickerFrom to stickerTo — e.g. 10 of item 0001 → 1.1 … 1.10; the
  // next purchase of that item carries on from 1.11. Inventory types only.
  stickerFrom  Int?      @map("sticker_from")
  stickerTo    Int?      @map("sticker_to")
  remarks      String?
  createdById  Int       @map("created_by_id")
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("purchases")
}

// Phase 4/Rev2: Job Card is the central sales-side workflow record.
// jobCardNumber follows the same pattern as Item Code — derived from the
// row's own id right after insert (JC-000123), never hand-typed.
//
// Status is a plain string (not a Postgres enum), same reasoning as Role.
// Parts/labour edits are blocked from INVOICED onward (see
// jobCardParts/jobCardLabour services and lib/jobCardStatus.ts) so a
// financial record, once invoiced, can't silently drift from what was
// actually billed.
model JobCard {
  id               Int       @id @default(autoincrement())
  jobCardNumber    String    @unique @map("job_card_number")
  vehicleId        Int       @map("vehicle_id")
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  jobType          String?   @map("job_type") // GENERAL_SERVICE | ACCIDENTAL_CLAIM | AC | DENT_PAINT | MECHANICAL
  kmAtService      Int?      @map("km_at_service")
  complaint        String?
  requiredWork     String?   @map("required_work")
  expectedDelivery DateTime? @map("expected_delivery")
  notes            String?
  status           String    @default("OPEN") // OPEN | INVOICED | CANCELLED — see lib/jobCardStatus.ts

  // Initial inspection
  inspectionFindings String? @map("inspection_findings")

  // Estimate / customer approval — optional step
  estimateAmount     Decimal?  @map("estimate_amount") @db.Decimal(12, 2)
  estimateApproved   Boolean?  @map("estimate_approved") // null = not decided yet
  estimateApprovedAt DateTime? @map("estimate_approved_at")

  // Work assignment
  assignedEmployeeId Int?      @map("assigned_employee_id")
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])

  // Final inspection sign-off
  finalInspectionStatus String?   @map("final_inspection_status") // DONE | NOT_DONE
  finalInspectionBy     String?   @map("final_inspection_by")
  finalInspectionAt     DateTime? @map("final_inspection_at")

  deliveredAt DateTime? @map("delivered_at")

  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  media    JobCardMedia[]
  parts    JobCardPart[]
  labour   JobCardLabour[]
  invoice  Invoice?
  estimate Estimate?

  @@map("job_cards")
}

// Vehicle inspection photos/video, always linked to both the Job Card and
// (through it) the vehicle. phase (BEFORE/AFTER) distinguishes the two
// mandatory photo rounds the workshop actually does.
model JobCardMedia {
  id        Int      @id @default(autoincrement())
  jobCardId Int      @map("job_card_id")
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  mediaType String   @map("media_type") // PHOTO | VIDEO
  angle     String? // FRONT/REAR/LEFT/RIGHT/ROOF/INTERIOR/DASHBOARD/GLOVE_BOX/BOOT/WALKAROUND/OTHER
  phase     String   @default("BEFORE") @map("phase") // BEFORE | AFTER
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_card_media")
}

// One row per item used on a job card: the quantity taken out of stock.
// rate and amount are captured at the moment of issue (from Item.sellingPrice at
// that time) and never recomputed later, so a later item price change
// can't silently change what an already-issued job card is worth.
model JobCardPart {
  id          Int      @id @default(autoincrement())
  jobCardId   Int      @map("job_card_id")
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  // A part from inventory has itemId (and comes out of stock). A part that
  // isn't in inventory (bought outside for this job) has no item, just a
  // description, and touches no stock.
  itemId      Int?     @map("item_id")
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description String?
  quantity    Float    @default(1) // can be part of a unit, e.g. 0.5
  rate        Decimal  @db.Decimal(12, 2) // the item's MRP when issued
  amount      Decimal  @db.Decimal(12, 2) // quantity × rate
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("job_card_parts")
}

// The estimate shown to the customer before work starts — one per job card,
// pre-filled from it. Lines can be inventory items, parts not in inventory,
// or labour. Once the customer signs it, a photo of the signed copy is
// uploaded (approvalPhotoUrl) and the estimate is APPROVED and locked.
model Estimate {
  id               Int       @id @default(autoincrement())
  estimateNumber   String    @unique @map("estimate_number")
  jobCardId        Int       @unique @map("job_card_id")
  jobCard          JobCard   @relation(fields: [jobCardId], references: [id])
  estimateDate     DateTime  @default(now()) @map("estimate_date")
  taxRate          Decimal?  @map("tax_rate") @db.Decimal(5, 2) // % — optional
  notes            String?
  status           String    @default("DRAFT") // DRAFT | APPROVED
  approvalPhotoUrl String?   @map("approval_photo_url")
  approvedAt       DateTime? @map("approved_at")
  createdById      Int       @map("created_by_id")
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lines EstimateLine[]

  @@map("estimates")
}

model EstimateLine {
  id          Int      @id @default(autoincrement())
  estimateId  Int      @map("estimate_id")
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lineType    String   @map("line_type") // PART | LABOUR
  itemId      Int?     @map("item_id") // set when the part is from inventory
  item        Item?    @relation(fields: [itemId], references: [id])
  description String
  quantity    Float    @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([estimateId])
  @@map("estimate_lines")
}

model JobCardLabour {
  id          Int      @id @default(autoincrement())
  jobCardId   Int      @map("job_card_id")
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  description String
  technician  String?
  quantity    Float    @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("job_card_labour")
}

// Phase 5/Rev2: Invoice. Deliberately has no line-item tables of its own —
// parts and labour are read straight from the job card's (already
// immutable, already locked-at-invoice-time) records, so an invoice can
// never show different numbers than the job card it came from.
// invoiceNumber follows the same derive-from-own-id pattern as Item/Job
// Card. taxRate/taxAmount exist now, unused, so GST can be added later
// without a migration touching this table's shape.
// Payments are one InvoicePayment row each (so the history is kept);
// paymentAmount is their running total, kept in step in the same
// transaction as every payment. Pending/Partial/Paid is computed from
// paymentAmount vs totalAmount, never stored.
model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique @map("invoice_number")
  jobCardId     Int      @unique @map("job_card_id")
  jobCard       JobCard  @relation(fields: [jobCardId], references: [id])
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  partsTotal    Decimal  @map("parts_total") @db.Decimal(12, 2)
  labourTotal   Decimal  @map("labour_total") @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  taxRate       Decimal? @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal? @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentAmount Decimal  @default(0) @map("payment_amount") @db.Decimal(12, 2)
  createdById   Int      @map("created_by_id")
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  payments InvoicePayment[]

  @@map("invoices")
}

// A record of every admin change to a recorded payment — customer
// (INVOICE) or supplier (SUPPLIER) — with the values before and after
// (after is null for a deletion), who made it and when. Never edited.
model PaymentAudit {
  id          Int      @id @default(autoincrement())
  paymentKind String   @map("payment_kind") // INVOICE | SUPPLIER
  paymentId   Int      @map("payment_id")
  invoiceId   Int?     @map("invoice_id")
  supplierId  Int?     @map("supplier_id")
  action      String // EDIT | DELETE
  before      Json
  after       Json?
  changedById Int      @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  @@index([paymentKind, invoiceId])
  @@index([paymentKind, supplierId])
  @@map("payment_audits")
}

// One customer payment towards an invoice. Recorded from the invoice page,
// or from the Customers/Vehicles pages against a chosen unpaid invoice.
model InvoicePayment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  paymentMode String?  @map("payment_mode")
  reference   String?
  receivedBy  String?  @map("received_by")
  notes       String?
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_payments")
}

// Phase 6/Rev2: Attendance → Salary. A self-contained HR module — nothing
// else in the schema depends on it except JobCard's optional Work
// Assignment link.
// email/mobile/passwordHash added for the employee self-service attendance
// portal (separate login from the admin User table — see
// modules/employeePortal). passwordHash stays null until an admin sets a
// portal password for that employee; email is the portal login id.
model Employee {
  id                    Int      @id @default(autoincrement())
  name                  String
  role                  String?
  email                 String?  @unique
  mobile                String?
  passwordHash          String?  @map("password_hash")
  joiningDate           DateTime @map("joining_date")
  monthlySalary         Decimal  @map("monthly_salary") @db.Decimal(12, 2)
  monthlyLeaveAllowance Int      @default(0) @map("monthly_leave_allowance")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  attendance     Attendance[]
  salaryPayments SalaryPayment[]
  advances       EmployeeAdvance[]
  jobCards       JobCard[]

  @@map("employees")
}

// Money paid to an employee ahead of their salary, entered from the
// attendance sheet. It comes out of the salary for salaryMonth/salaryYear:
// normally the month it was given, or the next month when that month's
// salary was already being paid (see advances.service.ts). One row per
// advance, so the history of what was given when is kept.
model EmployeeAdvance {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  salaryMonth Int      @map("salary_month")
  salaryYear  Int      @map("salary_year")
  notes       String?
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([employeeId, salaryYear, salaryMonth])
  @@map("employee_advances")
}

// markedBy distinguishes a self-service portal punch (SELF — punchedAt/
// latitude/longitude always set, selfieUrl set if the employee chose to
// take one) from the admin's manual daily marking (ADMIN — the original
// Phase 6 flow, no location data). Both write the same row.
model Attendance {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  date          DateTime  @db.Date
  status        String // PRESENT | HALF_DAY | ABSENT | LEAVE
  markedBy      String    @default("ADMIN") @map("marked_by") // ADMIN | SELF
  // Optional clock-in / clock-out times, "HH:MM", entered on the sheet.
  inTime        String?   @map("in_time")
  outTime       String?   @map("out_time")
  punchedAt     DateTime? @map("punched_at")
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  selfieUrl     String?   @map("selfie_url")
  correctedById Int?      @map("corrected_by_id")
  correctedBy   User?     @relation(fields: [correctedById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@map("attendance")
}

// One row per employee per calendar month. grossSalary/netSalary are
// computed at calculation time from that month's Attendance rows (see
// employees.service.ts for the exact formula) and stored so a later
// attendance correction doesn't silently change an already-paid salary —
// recalculating is an explicit action, not automatic.
model SalaryPayment {
  id                  Int       @id @default(autoincrement())
  employeeId          Int       @map("employee_id")
  employee            Employee  @relation(fields: [employeeId], references: [id])
  periodMonth         Int       @map("period_month")
  periodYear          Int       @map("period_year")
  presentDays         Int       @map("present_days")
  absentDays          Int       @map("absent_days")
  leaveDays           Int       @map("leave_days")
  halfDays            Int       @default(0) @map("half_days")
  // Leave balance: what carried in from the previous month, and what's
  // left to carry into the next (see salary.service.ts#leaveBalanceFor).
  // Stored with the salary so a later attendance correction can't change
  // a month that's already been calculated.
  openingLeaveBalance Decimal?  @map("opening_leave_balance") @db.Decimal(6, 1)
  closingLeaveBalance Decimal?  @map("closing_leave_balance") @db.Decimal(6, 1)
  grossSalary         Decimal   @map("gross_salary") @db.Decimal(12, 2)
  // Total of the advances charged to this month, at calculation time.
  advanceDeduction    Decimal   @default(0) @map("advance_deduction") @db.Decimal(12, 2)
  netSalary           Decimal   @map("net_salary") @db.Decimal(12, 2)
  paymentAmount       Decimal   @default(0) @map("payment_amount") @db.Decimal(12, 2)
  paymentDate         DateTime? @map("payment_date")
  paymentMode         String?   @map("payment_mode")
  paymentBy           String?   @map("payment_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@unique([employeeId, periodMonth, periodYear])
  @@map("salary_payments")
}

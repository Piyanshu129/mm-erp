# Postgres connection (local dev default; use your Neon/hosted connection string in production)
DATABASE_URL="postgresql://mm_erp:mm_erp_dev_password@localhost:5432/mm_erp?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend origin(s) allowed to call this API with credentials.
# Comma-separated — Vercel gives a project several valid origins at once
# (production alias, git-branch URL, per-deployment URLs).
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Cookie
REFRESH_COOKIE_NAME="mm_erp_refresh"

# Initial admin user, created by `npm run prisma:seed` if it doesn't already exist
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@motorsmitra.local"
ADMIN_PASSWORD="ChangeMe123!"

# Optional: file storage. Leave all five unset for local dev (uploads go to
# backend/uploads/ on disk). Set all five in production on hosts with no
# persistent disk (e.g. Render) to upload to Cloudflare R2 or any
# S3-compatible bucket instead.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="mm-erp-uploads"
# R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

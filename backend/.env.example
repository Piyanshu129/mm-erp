# Postgres connection (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://mm_erp:mm_erp_dev_password@localhost:5432/mm_erp?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API with credentials
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Cookie
REFRESH_COOKIE_NAME="mm_erp_refresh"

# Initial admin user, created by `npm run prisma:seed` if it doesn't already exist
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@motorsmitra.local"
ADMIN_PASSWORD="ChangeMe123!"
